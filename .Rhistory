library(tidyverse)
library(sf)
getwd()
states <- st_read("/Users/kamrynmansfield/Desktop/US_State_Boundaries.geojson", quiet = TRUE) |>
select(FID, NAME, STATE_ABBR, geometry)
manual_states <- read_csv("/Users/kamrynmansfield/Desktop/states.csv")
new_states <- left_join(states, manual_states) |>
filter(!NAME %in% c("Puerto Rico", "U.S. Virgin Islands"))
# Create a new column 'range_category' using cut()
new_states$kam_night_ranges <- cut(new_states$KAM_NIGHTS,
breaks = c(0, 3, 10, 20, 10000),
labels = c("0-3", "3-10", "10-20", "20+"),
right = TRUE, # Include the rightmost break point
include.lowest = TRUE) # Include the lowest break point
# Manny nights
plot1 <- new_states |>
ggplot() +
scale_fill_brewer("Blues") +
geom_sf(aes(fill = kam_night_ranges), show.legend = F) +
coord_sf(crs = "EPSG:3082") +
theme_void() +
labs(title = "  Kamryn Nights Slept")
# Create a new column 'range_category' using cut()
new_states$bri_night_ranges <- cut(new_states$BRI_NIGHTS,
breaks = c(0, 3, 10, 20, 10000),
labels = c("0-3", "3-10", "10-20", "20+"),
right = TRUE, # Include the rightmost break point
include.lowest = TRUE) # Include the lowest break point
# Bri nights
plot2 <- new_states |>
ggplot() +
scale_fill_brewer("Blues") +
geom_sf(aes(fill = bri_night_ranges), show.legend = F) +
coord_sf(crs = "EPSG:3082") +
theme_void() +
labs(title = "  Brianna Nights Slept")
# Kam through
plot3 <- new_states |>
ggplot() +
geom_sf(aes(fill = factor(KAM_THROUGH)), show.legend = F) +
coord_sf(crs = "EPSG:3082") +
theme_void() +
labs(title = "  Manny Driven Through")
# Bri through
plot4 <- new_states |>
ggplot() +
geom_sf(aes(fill = factor(BRI_THROUGH)), show.legend = F) +
coord_sf(crs = "EPSG:3082") +
theme_void() +
labs(title = "  Brianna Driven Through")
new_states <- new_states |>
mutate(
THROUGH = case_when(
KAM_THROUGH == 1 & BRI_THROUGH == 1 ~ "Both",
KAM_THROUGH == 1 & is.na(BRI_THROUGH) ~ "Manny",
is.na(KAM_THROUGH) & BRI_THROUGH == 1 ~ "Brianna",
TRUE ~ NA_character_ # Handles cases where both are FALSE or other unexpected values
)
)
# Both through
plot5 <- new_states |>
ggplot() +
geom_sf(aes(fill = THROUGH)) +
coord_sf(crs = "EPSG:3082") +
theme_void() +
labs(title = "  States Driven Through")
plot5
new_states
plot4
plot3
shiny::runApp()
runApp()
