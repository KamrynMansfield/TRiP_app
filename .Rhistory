names(marta_data)
marta_data <- read_excel("../data/MARTA Data/Bus Data.xlsx", 4)
# filter to
marta_data_filter <- marta_data |>
mutate(date = ym(paste0(Year,"-",Month))) |>
filter(date < ym("2021-10"),
date >= ym("2013-01"))
# changing the reference month to Dec to match Atlanta model
marta_data_filter$Month <- relevel(factor(marta_data_filter$Month), ref = "12")
#
formula <- as.formula("log_UPT ~ log_VRM + log_Gas_price + log_Mean_Vacant_Percent + log_num_0_veh + Month | Route")
marta_model <- feols(formula, data=marta_data_filter, cluster= ~Route)
data.frame(var = names(coef(marta_model)),
coef_new = round(coef(marta_model),3)) |>
gt()
bus_data_excel_file <- "../data/MARTA Data/Bus Data.xlsx"
# read in the 4th sheet in the excel file
marta_data <- read_excel(bus_data_excel_file, 4)
# filter to the training years mentioned in the documentation (Jan 2013 - Sep 2021)
marta_data_filter <- marta_data |>
mutate(date = ym(paste0(Year,"-",Month))) |>
filter(date < ym("2021-10"),
date >= ym("2013-01"))
# changing the reference month to Dec to match Atlanta model
marta_data_filter$Month <- relevel(factor(marta_data_filter$Month), ref = "12")
# I'm pretty sure these are the variables mentioned in the documentation
formula <- as.formula("log_UPT ~ log_VRM + log_Gas_price + log_Mean_Vacant_Percent + log_num_0_veh + Month | Route")
marta_model <- feols(formula, data=marta_data_filter, cluster= ~Route)
# view the model coefficients
# (I used gt function so I can easily copy and past it into an excel)
data.frame(var = names(coef(marta_model)),
coef_new = round(coef(marta_model),3)) |>
gt()
